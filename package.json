{
  "name": "ycaptcha",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "terser captcha.js --compress --mangle -o public/captcha.js && next build",
    "start": "next start",
    "lint": "bunx --bun @biomejs/biome check",
    "lint:fix": "bunx --bun @biomejs/biome check --write --unsafe",
    "db:push": "bun --env-file=.env.local drizzle-kit push",
    "db:push:prod": "bun --env-file=.env.production drizzle-kit push",
    "db:push:test": "bun --env-file=.env.test drizzle-kit push",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "bun --env-file=.env.test playwright test",
    "test:e2e:ui": "bun --env-file=.env.test playwright test --ui",
    "test:integration": "bun --env-file=.env.test vitest run --config vitest.config.integration.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1013.0",
    "@better-auth/passkey": "^1.5.5",
    "@neondatabase/serverless": "^1.0.2",
    "@orama/tokenizers": "^3.1.18",
    "@radix-ui/react-icons": "^1.3.2",
    "@radix-ui/react-popover": "^1.1.15",
    "@react-email/components": "^1.0.12",
    "@sentry/nextjs": "^10",
    "@t3-oss/env-nextjs": "^0.13.10",
    "@types/mdx": "^2.0.13",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "better-auth": "^1.5.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.1",
    "fumadocs-core": "^16.7.9",
    "fumadocs-mdx": "^14.2.11",
    "fumadocs-openapi": "^10.6.3",
    "fumadocs-ui": "^16.7.9",
    "lucide-react": "^0.577.0",
    "motion": "^12.36.0",
    "next": "16.2",
    "next-intl": "^4.9.1",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-dropzone": "^15.0.0",
    "resend": "^6.12.2",
    "shadcn": "^4.0.7",
    "sharp": "^0.34.5",
    "shiki": "^4.0.2",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tegaki": "^0.13.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@react-email/ui": "^6.0.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.9",
    "lefthook": "^2.1.4",
    "react-email": "^6.0.0",
    "tailwindcss": "^4",
    "terser": "^5.46.1",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.0"
  },
  "ignoreScripts": [
    "sharp",
    "unrs-resolver"
  ],
  "trustedDependencies": [
    "sharp",
    "unrs-resolver"
  ]
}
