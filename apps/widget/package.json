{
  "name": "@ycaptcha/widget",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/server/index.ts",
    "build": "bun run build:loader && bun run build:client",
    "build:client": "vite build",
    "build:loader": "WIDGET_BUILD=loader vite build",
    "start": "bun run src/server/index.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.2.4",
    "@ycaptcha/api": "workspace:*",
    "@ycaptcha/shared": "workspace:*",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.10.4",
    "lucide-react": "^1.14.0",
    "postgres": "^3.4.9",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.2.4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bun": "^1.3.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^5.0.0",
    "terser": "^5.46.1",
    "typescript": "^5",
    "vite": "^6.0.0"
  }
}
